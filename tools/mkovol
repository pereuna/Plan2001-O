#!/bin/bash
# Plan2001: make a new native O volume image (docs/O-FORMAT.md).
# This is a host-side preparation tool: it formats a disposable raw
# image with the tree's userspace gefs in the build VM, using GE's own
# arena/tree/sync code.  The result has the O profile, no FS root, adm
# tree or user table, and one flat catalog entry: init -> SpaceID 1.
# Opening an O volume in the kernel never formats it.
#   tools/mkovol OUT [MIB] [SOURCE]
#                             MIB, default 512; at least 129.  With
#                             SOURCE, also seed one demo Environment and
#                             its compiled .mpy as O objects in the fresh
#                             image (Stage 4, tools/oseed.py).
#   NATIVEEXEC=FILE           also seed FILE as the native executable test
#                             object (requires SOURCE; see docs/O-FORMAT.md).
#   RAWEXEC=FILE              also seed FILE verbatim at the Experiment C
#                             fixture OID 0x4f45584543000004 (requires SOURCE;
#                             no header patching).
#   MPEXEC=FILE               seed FILE as the MicroPython executable byte for
#                             byte at OID 0x4f45584543000003 (requires SOURCE).
#                             With SOURCE and no MPEXEC, the built selfroot
#                             micropython is seeded by default: every fresh
#                             runnable O image then boots the normal O path.
#   NOMPEXEC=1                with SOURCE, omit the interpreter (an older or
#                             diagnostic image; the normal boot then reports a
#                             missing object).  Not valid with MPEXEC.
#   REGALLOC=FILE             test fixture: append FILE's bytes to the
#                             Space header's allocator area (requires SOURCE).
#   GEFS=FILE                 userspace gefs (default
#                             build/selfroot/amd64/bin/gefs)
set -e
here=$(cd "$(dirname "$0")" && pwd); root=$(dirname "$here")
. "$here/target.sh"
[ $# -ge 1 ] && [ $# -le 3 ] || { echo "usage: tools/mkovol OUT [MIB] [SOURCE]" >&2; exit 2; }
out=$(realpath -m "$1")
mb=${2:-512}
src=$3
native=${NATIVEEXEC:-}
rawexec=${RAWEXEC:-}
mpexec=${MPEXEC:-}
nompexec=${NOMPEXEC:-}
regalloc=${REGALLOC:-}
[ "$mb" -ge 129 ] || { echo "mkovol: image must be at least 129 MiB" >&2; exit 2; }
[ -z "$native" ] || [ -r "$native" ] || { echo "mkovol: NATIVEEXEC: no $native" >&2; exit 1; }
[ -z "$rawexec" ] || [ -r "$rawexec" ] || { echo "mkovol: RAWEXEC: no $rawexec" >&2; exit 1; }
[ -z "$mpexec" ] || [ -r "$mpexec" ] || { echo "mkovol: MPEXEC: no $mpexec" >&2; exit 1; }
[ -z "$nompexec" ] || [ -z "$mpexec" ] || { echo "mkovol: NOMPEXEC and MPEXEC are exclusive" >&2; exit 2; }
[ -z "$regalloc" ] || [ -r "$regalloc" ] || { echo "mkovol: REGALLOC: no $regalloc" >&2; exit 1; }
[ -z "$regalloc" ] || [ -n "$src" ] || { echo "mkovol: REGALLOC requires SOURCE" >&2; exit 2; }
[ -z "$native" ] || [ -n "$src" ] || { echo "mkovol: NATIVEEXEC requires SOURCE" >&2; exit 2; }
[ -z "$rawexec" ] || [ -n "$src" ] || { echo "mkovol: RAWEXEC requires SOURCE" >&2; exit 2; }
[ -z "$mpexec" ] || [ -n "$src" ] || { echo "mkovol: MPEXEC requires SOURCE" >&2; exit 2; }
[ -z "$nompexec" ] || [ -n "$src" ] || { echo "mkovol: NOMPEXEC requires SOURCE" >&2; exit 2; }
dir=$root/build/selfroot
gefs=${GEFS:-$dir/amd64/bin/gefs}
[ -x "$gefs" ] || { echo "mkovol: no $gefs (tools/selfroot)" >&2; exit 1; }
mp=$dir/amd64/bin/micropython
[ -z "$src" ] || [ -n "$nompexec" ] || [ -x "$mp" ] || { echo "mkovol: no $mp (tools/selfroot)" >&2; exit 1; }
if [ -n "$src" ] && [ -z "$mpexec" ] && [ -z "$nompexec" ]; then
	mpexec=$mp
fi
b=$root/build
rm -f "$b/in.img" "$b/out.img"
tar cf "$b/in.img" --format=ustar --owner=0 --group=0 -C "$dir" ./amd64/bin/gefs
if [ -n "$src" ]; then
	cp "$src" "$b/odemo.py"
	tar rf "$b/in.img" --format=ustar --owner=0 --group=0 -C "$dir" ./amd64/bin/micropython -C "$b" ./odemo.py -C "$here" ./oseed.py
	if [ -n "$native" ]; then
		cp "$native" "$b/nativeexec"
		tar rf "$b/in.img" --format=ustar --owner=0 --group=0 -C "$b" ./nativeexec
	fi
	if [ -n "$rawexec" ]; then
		cp "$rawexec" "$b/rawexec"
		tar rf "$b/in.img" --format=ustar --owner=0 --group=0 -C "$b" ./rawexec
	fi
	if [ -n "$mpexec" ]; then
		cp "$mpexec" "$b/mpexec"
		tar rf "$b/in.img" --format=ustar --owner=0 --group=0 -C "$b" ./mpexec
	fi
	if [ -n "$regalloc" ]; then
		cp "$regalloc" "$b/regalloc"
		tar rf "$b/in.img" --format=ustar --owner=0 --group=0 -C "$b" ./regalloc
	fi
fi
truncate -s $(( $(stat -c %s "$b/in.img") / 1048576 + 16 ))M "$b/in.img"
truncate -s ${mb}M "$b/out.img"

trap '"$here/vm" stop >/dev/null 2>&1 || true' EXIT
"$here/vm" start >/dev/null
printf 'term%% \t!done\n' | "$here/9run" -t 180 --dialog - >/dev/null
if [ -n "$src" ]; then
"$here/9run" -t "${MKOVOL_TIMEOUT:-600}" --script - <<'RC'
g=/dev/sdE2/data
cd /tmp && tar xf /dev/sdE1/data
mkdir -p /tmp/seed/mod
/tmp/amd64/bin/micropython /tmp/oseed.py >/tmp/oseed.log >[2=1] || { cat /tmp/oseed.log; exit seed }
cat /tmp/oseed.log
/tmp/amd64/bin/gefs -O -i /tmp/seed -f $g >/tmp/mkovol.log >[2=1] || { tail -5 /tmp/mkovol.log; exit ream }
grep -s '^reaming O volume' /tmp/mkovol.log || { cat /tmp/mkovol.log; exit ream }
grep '^seed:' /tmp/mkovol.log || { cat /tmp/mkovol.log; exit seed }
echo mkovol-ok
RC
else
"$here/9run" -t "${MKOVOL_TIMEOUT:-600}" --script - <<'RC'
g=/dev/sdE2/data
cd /tmp && tar xf /dev/sdE1/data ./amd64/bin/gefs
gefs=/tmp/amd64/bin/gefs
$gefs -O -f $g >/tmp/mkovol.log >[2=1] || { tail -5 /tmp/mkovol.log; exit ream }
grep -s '^reaming O volume' /tmp/mkovol.log || { cat /tmp/mkovol.log; exit ream }
echo mkovol-ok
RC
fi
"$here/vm" stop >/dev/null; trap - EXIT
mv "$b/out.img" "$out"
rm -f "$b/in.img"
if [ -n "$src" ]; then
	echo "mkovol: $out ($mb MiB), O profile version 1, init -> 1, seeded from $src${native:+, native executable $native}${rawexec:+, raw executable $rawexec}${mpexec:+, MicroPython executable $mpexec}"
else
	echo "mkovol: $out ($mb MiB), O profile version 1, init -> 1"
fi
