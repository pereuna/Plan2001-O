#!/bin/bash
# OPTIONAL LEGACY CPU-SERVER TOOL: external Monolith 9pterm/drawterm
# connects from Linux to inherited Plan 9 CPU servers. This is neither
# required for the O-only QEMU gates nor a native GE/O remote protocol.
# Monolith is its own repo: $MONOLITH, default ~/Src/monolith; its
# monolith/tools/build makes 9pterm when there is none.  NINEPTERM names
# another binary.
#   tools/9pterm ARGS...      9pterm's own arguments
m=${MONOLITH:-$HOME/Src/monolith}
t=${NINEPTERM:-$m/monolith/build/9pterm/9pterm}
if [ ! -x "$t" ]; then
	[ -z "$NINEPTERM" ] && [ -x "$m/monolith/tools/build" ] || { echo "9pterm: no $t (Monolith: MONOLITH=DIR, or NINEPTERM=FILE)" >&2; exit 2; }
	"$m/monolith/tools/build" 9pterm >&2 || exit 2
fi
exec "$t" "$@"
