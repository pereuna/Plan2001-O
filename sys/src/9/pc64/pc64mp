# No bootfs.paq/paqfs/bootrc.  TEST-ONLY: embeds the historical /boot/mp
# interpreter so the Stage 1-4 probes and legacy file/DMOBJ gates keep their
# original harness.  Normal boots use pc64 and never fall back to this image.
bootdir
	/$objtype/bin/micropython	mp
	/$objtype/bin/aux/kbdfs	kbdfs
